# Input: docker build context
# Output: 排除无关文件加速构建
# Pos: 根目录Docker构建过滤

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
*.egg-info

# 版本控制
.git
.gitignore
.github

# 密钥/环境
.env
.env.*
!.env-example

# 文档/图片 (保留requirements.txt)
docs/
images/
*.md
!requirements.txt

# 数据/日志 (挂载volume, 不进镜像)
data/
logs/
eval_results/

# 前端 (后端镜像不需要)
frontend/node_modules/
frontend/.next/
frontend/out/

# IDE
.idea/
.vscode/
.DS_Store

# 测试
tests/
.coverage
htmlcov/

# 第三方 (通过volume挂载)
third_party/

# 临时
*.log
*.tmp
*.swp
*.swo
