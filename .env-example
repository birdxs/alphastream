# API 提供商 (openai SDK)
API_PROVIDER=openai #使用openai格式的api即可，无需修改

# OpenAI API 配置 使用openai格式的api
OPENAI_API_URL=https://***/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_MODEL=your_open_model
NEWS_MODEL=your_open_news_model
EMBEDDING_MODEL=text-embedding-3-small


# 其他新闻获取接口 Serp 和 tavily（免费1000次/月） 二选一即可，如果都选，都会使用
SERP_API_KEY=your_serp_api_key # Serp key申请地址：https://serper.dev/api-key
TAVILY_API_KEY=your_tavily_api_key # tavily key申请地址：https://app.tavily.com/playground
FINNHUB_API_KEY=your_finnhub_api_key # Finnhub key申请地址: https://finnhub.io/dashboard

FUNCTION_CALL_MODEL=your_function_call_model

# QA上下文数量
MAX_QA=10

# 安全配置
# API_KEY=your_api_key_for_protected_endpoints
# HMAC_SECRET=your_hmac_secret_key_for_webhook_verification
# 允许的跨域来源（逗号分隔）
# ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888

# Agent系统开关（true=新LangGraph多Agent系统, false=旧TradingAgents）
USE_AGENT_SYSTEM=true

# Redis缓存设置(可选)
# REDIS_URL=redis://redis:6379  #docker配置
REDIS_URL=redis://localhost:6379
USE_REDIS_CACHE=False

# 数据库设置(可选)
# DATABASE_URL=sqlite:///app/data/stock_analyzer.db  #docker配置
DATABASE_URL=sqlite:///data/stock_analyzer.db
USE_DATABASE=False

# 日志配置
# 可选的日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/stock_analyzer.log

# ─────────────────────────────────────────────────────────────
# 数据层v2适配器 Key/UA 配置 (2026-04-15 Phase-4落盘)
# 所有Key均为免费申请, 未配置时adapter走软降级不崩溃
# ─────────────────────────────────────────────────────────────

# FRED (Federal Reserve Economic Data) - 美国宏观80万序列
# 免费申请(仅需邮箱): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# OpenCorporates - 全球企业工商/股权/董事信息
# 免费层500 calls/month申请: https://api.opencorporates.com/documentation/API-Reference
OPENCORPORATES_API_KEY=your_opencorporates_api_key
# 可选自定义UA (默认内置)
# OPENCORPORATES_UA=StockAnalSys/1.0 research@example.com

# SEC EDGAR - 美股XBRL标准财报 (无需Key, 但Fair Access Policy强制要求UA)
# 格式: "CompanyName AdminEmail" - SEC会根据UA跟踪请求者
# 参考: https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_UA=StockAnalSys research@example.com

# AISHub - 船舶AIS实时位置 (免费注册feed): https://www.aishub.net/api
# 未配置则 ShippingAdapter.get_ais_vessels 返回空DataFrame软降级
AISHUB_USERNAME=your_aishub_username

# Jobs Adapter (Arbeitnow) - 默认无需Key, 仅可选UA覆盖
# JOBS_ADAPTER_UA=StockAnalSys/1.0 jobs-scanner@example.com

# ─────────────────────────────────────────────────────────────
# H4 HTTP 代理配置 (境外 adapter: yfinance/EDGAR/FRED/ccxt/CoinGecko/WorldBank/IMF/
# shipping/satellite/corporate/jobs/esg/rss_news 等)
# 未配置则直连；境内网络下访问 Yahoo/Binance/SEC/NASA 等常见 403/451/超时
# requests/urllib 自动继承大写 env；yfinance/ccxt 已在代码中显式透传
# ─────────────────────────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,akshare.com,baostock.com,stats.gov.cn,sse.com.cn,szse.cn

# ===== Timeout Configuration (2026-05-18 拉富足化) =====
# LLM/AI 推理调用 (单位:秒)
AI_HTTP_TIMEOUT=600              # LLM HTTP 客户端总超时（OpenAI/Anthropic/DeepSeek/Qwen）
AI_HTTP_CONNECT_TIMEOUT=15       # LLM HTTP 连接超时
AI_CHAT_TIMEOUT=1800             # 单轮 chat 端到端（含工具链）
AGENT_GRAPH_TIMEOUT=1800         # LangGraph agent 多轮 graph timeout

# 外部数据 API (单位:秒)
NETWORK_RESILIENCE_DEFAULT_TIMEOUT=30   # resilient_call 全局默认
NETWORK_RESILIENCE_CACHE_TTL=600        # resilient_call 缓存 TTL

# 内部 ThreadPoolExecutor (单位:秒)
STOCK_DATA_THREAD_TIMEOUT=50            # /api/stock_data 整体超时
ADAPTERS_STATUS_OVERALL_TIMEOUT=10      # /api/adapters/status 健康检查整体超时
ADAPTERS_STATUS_PER_CALL_TIMEOUT=5      # 单 adapter 健康检查超时
ALT_DATA_SUBTASK_TIMEOUT=45             # alt_data 子任务

# 前端 (单位:毫秒) — 客户端下限 180s；SSE 默认 360s（禁止 25–60s 砍断长链路）
NEXT_PUBLIC_API_DEFAULT_TIMEOUT_MS=180000   # 前端 fetch 默认超时（≥180s）
NEXT_PUBLIC_SSE_HEARTBEAT_TIMEOUT_MS=360000 # SSE 空闲心跳超时（默认 6min）

# 市场指数
INDEX_CACHE_TTL_S=120                       # 新鲜缓存 TTL（秒）
INDEX_REFRESH_INTERVAL_S=45                 # 后台预热刷新间隔（秒）
INDEX_FAST_TIMEOUT_MS=8000                  # 路由快超时（毫秒）；有 stale 真数则回退

# Wind(万得) MCP 数据源 (P1 离线层，不填密钥则禁用)
WIND_API_KEY=                                # Wind MCP Bearer 密钥，留空则 WindAdapter 禁用
WIND_DATABASE_URL=sqlite:///data/wind_cache.db  # Wind 缓存/配额独立库(与业务库隔离)
WIND_QUOTA_S=50                              # S 档(财务等高价值)日配额，硬隔离
WIND_QUOTA_A=30                              # A 档日配额
WIND_QUOTA_B=20                              # B 档(基本信息等)日配额
WIND_CALL_TIMEOUT=600                        # tools/call 超时(秒)

